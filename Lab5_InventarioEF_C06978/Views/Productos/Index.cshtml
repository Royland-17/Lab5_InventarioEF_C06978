@model IEnumerable<Lab5_InventarioEF_C06978.Models.Producto>

@{
    ViewData["Title"] = "Catálogo de Productos";
}

<h1>Catálogo de Productos</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Agregar Nuevo Producto</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Precio</th>
            <th>Categoría</th>
            <th>Fecha de Ingreso</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model) {
        <tr>
            <td>@item.Nombre</td>
            <td>@item.Precio.ToString("C")</td>
            <td>@item.Categoria</td>
            <td>@item.FechaIngreso.ToShortDateString()</td>
            <td>@(item.Activo ? "Activo" : "Inactivo")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Editar</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Eliminar</a>
            </td>
        </tr>
    }
    </tbody>
</table>